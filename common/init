#!/bin/bash
#################
# Launcher init #
#################

# shellcheck disable=SC2034
START=$(date +%s.%N)

# ensure_dir_exists calls `mkdir -p` if the given path is not a directory.
# This speeds up execution time by avoiding unnecessary calls to mkdir.
#
# Usage: ensure_dir_exists <path> [<mkdir-options>]...
#
function ensure_dir_exists() {
  [ -d "$1" ] ||  mkdir -p "$@"
}

declare -A PIDS
declare -A ASYNC_EXPORT_READ_FDS

# Use async_export NAME=value from a function started by async_exec_with_exports.
function async_export() {
  [ -n "${ASYNC_EXPORT_WRITE_FD:-}" ] || return 2
  export "$@" || return
  printf '%s\0' "$@" >&"$ASYNC_EXPORT_WRITE_FD"
}

function async_exec() {
  "$@" &
  PIDS[$!]=$*
}

function async_exec_with_exports() {
  # Process substitution uses stdout for the export pipe, so preserve the
  # command's stdout on a separate descriptor.
  local command_stdout_fd export_read_fd export_write_fd
  exec {command_stdout_fd}>&1
  exec {export_read_fd}< <(
    exec {export_write_fd}>&1
    ASYNC_EXPORT_WRITE_FD=$export_write_fd "$@" >&"$command_stdout_fd"
  )

  local pid=$!
  exec {command_stdout_fd}>&-
  PIDS[$pid]=$*
  ASYNC_EXPORT_READ_FDS[$pid]=$export_read_fd
}

function wait_for_async_execs() {
  local status export_read_fd assignment
  for pid in "${!PIDS[@]}"
  do
    export_read_fd=${ASYNC_EXPORT_READ_FDS[$pid]:-}
    if [ -n "$export_read_fd" ]; then
      # NUL delimiters preserve spaces, newlines, and other shell characters.
      while IFS= read -r -d '' -u "$export_read_fd" assignment; do
        export "$assignment"
      done
      exec {export_read_fd}<&-
    fi

    status=0
    wait "$pid" || status=$?
    [ "$status" -eq 0 ] || echo "ERROR: ${PIDS[$pid]} exited abnormally with status $status"
  done
}

# shellcheck source=/dev/null
source "$SNAP_USER_DATA/.last_revision" 2>/dev/null || true
if [ "$SNAP_DESKTOP_LAST_REVISION" = "$SNAP_REVISION" ]; then
  needs_update=false
else
  needs_update=true
fi

# Set $REALHOME to the users real home directory
REALHOME=${SNAP_REAL_HOME}

# Set config folder to local path
export XDG_CONFIG_HOME="$SNAP_USER_DATA/.config"
ensure_dir_exists "$XDG_CONFIG_HOME"
chmod 700 "$XDG_CONFIG_HOME"

# If there is no user user-dirs, don't check for the checksum
if [[ -f "$SNAP_REAL_HOME/.config/user-dirs.dirs" ]]; then
  # If the user has modified their user-dirs settings, force an update
  if [[ -f "$XDG_CONFIG_HOME/user-dirs.dirs.md5sum" ]]; then
    if [[ "$(md5sum < "$SNAP_REAL_HOME/.config/user-dirs.dirs")" != "$(cat "$XDG_CONFIG_HOME/user-dirs.dirs.md5sum")" ||
          ( -f "$XDG_CONFIG_HOME/user-dirs.locale.md5sum" &&
            "$(md5sum < "$SNAP_REAL_HOME/.config/user-dirs.locale")" != "$(cat "$XDG_CONFIG_HOME/user-dirs.locale.md5sum")" ) ]]; then
      needs_update=true
    fi
  else
    # shellcheck disable=SC2034
    needs_update=true
  fi
fi

if [ "$SNAP_ARCH" = "amd64" ]; then
  ARCH="x86_64-linux-gnu"
elif [ "$SNAP_ARCH" = "armhf" ]; then
  ARCH="arm-linux-gnueabihf"
elif [ "$SNAP_ARCH" = "arm64" ]; then
  ARCH="aarch64-linux-gnu"
elif [ "$SNAP_ARCH" = "ppc64el" ]; then
  ARCH="powerpc64le-linux-gnu"
else
  ARCH="$SNAP_ARCH-linux-gnu"
fi

export SNAP_LAUNCHER_ARCH_TRIPLET="$ARCH"

# Don't LD_PRELOAD bindtextdomain for classic snaps
if ! grep -qs "^\s*confinement:\s*classic\s*" "$SNAP/meta/snap.yaml"; then
  # $SNAP/lib is not automatically symlinked to usr/lib; check usr/lib first.
  if [ -f "$SNAP/usr/lib/$ARCH/bindtextdomain.so" ]; then
    export LD_PRELOAD="$LD_PRELOAD:$SNAP/usr/\$LIB/bindtextdomain.so"
  elif [ -f "$SNAP/lib/$ARCH/bindtextdomain.so" ]; then
    export LD_PRELOAD="$LD_PRELOAD:$SNAP/\$LIB/bindtextdomain.so"
  elif [ -f "$SNAP/gnome-platform/usr/lib/$ARCH/bindtextdomain.so" ]; then
    export LD_PRELOAD="$LD_PRELOAD:$SNAP/gnome-platform/usr/\$LIB/bindtextdomain.so"
  elif [ -f "$SNAP/gnome-platform/lib/$ARCH/bindtextdomain.so" ]; then
    export LD_PRELOAD="$LD_PRELOAD:$SNAP/gnome-platform/\$LIB/bindtextdomain.so"
  fi
fi

# Check if the desktop runtime has been updated

USER_CACHE_FOLDER="$SNAP_USER_COMMON/.cache"
RUNTIME_LAST_DATE="$USER_CACHE_FOLDER/desktop-runtime-date"

if [ ! -f "$RUNTIME_LAST_DATE" -o \
       "$SNAP_DESKTOP_RUNTIME" -nt "$RUNTIME_LAST_DATE" -o \
       "$SNAP_DESKTOP_RUNTIME" -ot "$RUNTIME_LAST_DATE" ]; then
  needs_update=true
  mkdir -p "$USER_CACHE_FOLDER"
  touch -r "$SNAP_DESKTOP_RUNTIME" "$RUNTIME_LAST_DATE"
fi
